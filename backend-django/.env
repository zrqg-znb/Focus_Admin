# JWT 密钥
JWT_ACCESS_SECRET_KEY=your-jwt-access-secret
JWT_REFRESH_SECRET_KEY=your-jwt-refresh-secret

# 数据库配置
DATABASE_TYPE=MYSQL
DATABASE_HOST=rm-2ze7td37h05fd80qnpo.mysql.rds.aliyuncs.com
DATABASE_PORT=3306
