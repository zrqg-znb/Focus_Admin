# ================================================= #
# ************ 代码合规漏合检测配置 *************** #
# ================================================= #
# 公司数据湖 CR 查询接口；为空时自动使用 mock 数据
CODE_COMPLIANCE_CR_API_URL=
# 数据湖 Bearer Token；未配置鉴权时保持为空
CODE_COMPLIANCE_CR_API_TOKEN=
# 额外请求头 JSON，例如 {"X-App-Id":"focus-admin"}
CODE_COMPLIANCE_CR_API_HEADERS_JSON={}
# 是否强制使用 mock；URL 为空时即使 false 也会 mock
CODE_COMPLIANCE_CR_FORCE_MOCK=false
# 数据湖请求超时时间（秒）
CODE_COMPLIANCE_CR_API_TIMEOUT=15
# 是否校验 HTTPS 证书
CODE_COMPLIANCE_CR_API_VERIFY_SSL=true
# 拉取 CR 明细的分页大小
CODE_COMPLIANCE_CR_PAGE_SIZE=100
# 定时任务默认扫描最近多少天的合入数据
CODE_COMPLIANCE_CR_SCHEDULE_WINDOW_DAYS=1

# ================================================= #
# *************** DeepAudit 核心配置 **************** #
# ================================================= #
# 是否开启 Docker 沙箱 (true/false)。如果本机没有装 Docker，请设为 false
DEEPAUDIT_DOCKER_ENABLED=true
# DeepAudit 的 Celery 消费队列名
DEEPAUDIT_QUEUE=deepaudit

# ================================================= #
# *************** LLM 厂商 API Keys **************** #
# ================================================= #
# 1. DeepSeek 配置
DEEPSEEK_API_KEY=sk-a5ff2ee8a6674c2f972e37b6a8ceb7d4

# 2. Claude (Anthropic) 配置
CLAUDE_API_KEY=sk-ant-your-claude-key

# 3. OpenAI 配置
OPENAI_API_KEY=sk-your-openai-key
# 如果你使用中转 API（自定义的 OpenAI 兼容接口），请配置下面这个地址：
OPENAI_BASE_URL=https://api.your-custom-proxy.com/v1

# 4. 本地 Ollama 配置 (不需要 Key)
# 默认指向本机的 11434 端口
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# 5. 其他国内大模型配置 (按需开启)
QWEN_API_KEY=sk-your-qwen-key            # 阿里通义千问
ZHIPU_API_KEY=your-zhipu-key             # 智谱 GLM
MOONSHOT_API_KEY=sk-your-kimi-key        # 月之暗面 Kimi
